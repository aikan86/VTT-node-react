{
  "name": "vtt-elixir",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"pnpm --filter @vtt/server dev\" \"pnpm --filter @vtt/client dev\"",
    "build": "pnpm --filter @vtt/client build",
    "start": "pnpm --filter @vtt/server start",
    "release": "bash scripts/release.sh",
    "prod": "bash scripts/vtt.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
